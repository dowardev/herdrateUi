{
  "name": "ui-lib",
  "private": true,
  "scripts": {
    "docs:dev": "pnpm --filter herdrate-docs run docs:dev",
    "test": "node ./node_modules/.pnpm/vitest@3.1.3_happy-dom@15.11.7_lightningcss@1.32.0/node_modules/vitest/vitest.mjs run",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "biome format .",
    "check:md-pipes": "grep -rnF '\\\\|' docs/components/*.md && exit 1 || exit 0",
    "check": "biome check . && pnpm check:md-pipes"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^15.11.0",
    "turbo": "latest",
    "vite": "^6.0.0",
    "vitest": "3.1.3",
    "vue": "^3.5.39"
  },
  "packageManager": "pnpm@11.3.0"
}
